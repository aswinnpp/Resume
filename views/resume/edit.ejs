<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Resume - Resume Builder</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container py-5">
        <div class="row mb-4">
            <div class="col">
                <h1 class="display-4">Edit Resume</h1>
                <p class="lead">Fill in your resume details</p>
            </div>
            <div class="col-auto">
                <a href="/dashboard" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>

        <% if (messages && messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= messages.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (messages && messages.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= messages.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row">
            <div class="col-md-3">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">Resume Progress</h5>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3">
                            <div class="progress-bar" role="progressbar" style="width: <%= resume.completionStatus %>%" 
                                 aria-valuenow="<%= resume.completionStatus %>" aria-valuemin="0" aria-valuemax="100">
                                <%= resume.completionStatus %>%
                            </div>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="#personal-info" class="text-decoration-none">Personal Info</a>
                                <i class="fas fa-check-circle text-success"></i>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="#education" class="text-decoration-none">Education</a>
                                <i class="fas fa-check-circle text-success"></i>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="#experience" class="text-decoration-none">Experience</a>
                                <i class="fas fa-check-circle text-success"></i>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="#skills" class="text-decoration-none">Skills</a>
                                <i class="fas fa-check-circle text-success"></i>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="#projects" class="text-decoration-none">Projects</a>
                                <i class="fas fa-check-circle text-success"></i>
                            </li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <a href="/resume/preview/<%= resume._id %>" class="btn btn-outline-primary w-100" target="_blank">
                            <i class="fas fa-eye"></i> Preview Resume
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">Resume Details</h5>
                    </div>
                    <div class="card-body">
                        <form id="resumeForm" data-resume-id="<%= resume._id %>">
                            <div class="mb-4" id="personal-info">
                                <h4>Personal Information</h4>
                                <hr>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="fullName" class="form-label">Full Name</label>
                                        <input type="text" class="form-control" id="fullName" name="fullName" 
                                               value="<%= resume.personalInfo ? resume.personalInfo.fullName : '' %>" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="email" name="email" 
                                               value="<%= resume.personalInfo ? resume.personalInfo.email : '' %>" required>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="phone" class="form-label">Phone</label>
                                        <input type="tel" class="form-control" id="phone" name="phone" 
                                               value="<%= resume.personalInfo ? resume.personalInfo.phone : '' %>">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="location" class="form-label">Location</label>
                                        <input type="text" class="form-control" id="location" name="location" 
                                               value="<%= resume.personalInfo ? resume.personalInfo.location : '' %>">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="summary" class="form-label">Professional Summary</label>
                                    <textarea class="form-control" id="summary" name="summary" rows="4"><%= resume.summary || '' %></textarea>
                                </div>
                            </div>

                            <div class="mb-4" id="education">
                                <h4>Education</h4>
                                <hr>
                                <div id="educationContainer">
                                    <% if (resume.education && resume.education.length > 0) { %>
                                        <% resume.education.forEach((edu, index) => { %>
                                            <div class="education-item mb-3 p-3 border rounded">
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">School</label>
                                                        <input type="text" class="form-control" name="education[<%= index %>][school]" 
                                                               value="<%= edu.school %>" required>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Degree</label>
                                                        <input type="text" class="form-control" name="education[<%= index %>][degree]" 
                                                               value="<%= edu.degree %>" required>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Field of Study</label>
                                                        <input type="text" class="form-control" name="education[<%= index %>][field]" 
                                                               value="<%= edu.field %>">
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">GPA</label>
                                                        <input type="text" class="form-control" name="education[<%= index %>][gpa]" 
                                                               value="<%= edu.gpa %>">
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Start Date</label>
                                                        <input type="date" class="form-control" name="education[<%= index %>][startDate]" 
                                                               value="<%= edu.startDate ? edu.startDate.toISOString().split('T')[0] : '' %>" required>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">End Date</label>
                                                        <input type="date" class="form-control" name="education[<%= index %>][endDate]" 
                                                               value="<%= edu.endDate ? edu.endDate.toISOString().split('T')[0] : '' %>" required>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Description</label>
                                                    <textarea class="form-control" name="education[<%= index %>][description]" rows="2"><%= edu.description || '' %></textarea>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-danger remove-education">Remove</button>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="education-item mb-3 p-3 border rounded">
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">School</label>
                                                    <input type="text" class="form-control" name="education[0][school]" required>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Degree</label>
                                                    <input type="text" class="form-control" name="education[0][degree]" required>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Field of Study</label>
                                                    <input type="text" class="form-control" name="education[0][field]">
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">GPA</label>
                                                    <input type="text" class="form-control" name="education[0][gpa]">
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Start Date</label>
                                                    <input type="date" class="form-control" name="education[0][startDate]" required>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">End Date</label>
                                                    <input type="date" class="form-control" name="education[0][endDate]" required>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Description</label>
                                                <textarea class="form-control" name="education[0][description]" rows="2"></textarea>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-danger remove-education">Remove</button>
                                        </div>
                                    <% } %>
                                </div>
                                <button type="button" class="btn btn-outline-primary" id="addEducation">
                                    <i class="fas fa-plus"></i> Add Education
                                </button>
                            </div>

                            <div class="mb-4" id="experience">
                                <h4>Experience</h4>
                                <hr>
                                <div id="experienceContainer">
                                    <% if (resume.experience && resume.experience.length > 0) { %>
                                        <% resume.experience.forEach((exp, index) => { %>
                                            <div class="experience-item mb-3 p-3 border rounded">
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Company</label>
                                                        <input type="text" class="form-control" name="experience[<%= index %>][company]" 
                                                               value="<%= exp.company %>" required>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Position</label>
                                                        <input type="text" class="form-control" name="experience[<%= index %>][position]" 
                                                               value="<%= exp.position %>" required>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Location</label>
                                                        <input type="text" class="form-control" name="experience[<%= index %>][location]" 
                                                               value="<%= exp.location %>">
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Start Date</label>
                                                        <input type="date" class="form-control" name="experience[<%= index %>][startDate]" 
                                                               value="<%= exp.startDate ? exp.startDate.toISOString().split('T')[0] : '' %>" required>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">End Date</label>
                                                    <input type="date" class="form-control" name="experience[<%= index %>][endDate]" 
                                                           value="<%= exp.endDate ? exp.endDate.toISOString().split('T')[0] : '' %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Description</label>
                                                    <textarea class="form-control" name="experience[<%= index %>][description]" rows="3"><%= exp.description || '' %></textarea>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Achievements (one per line)</label>
                                                    <textarea class="form-control" name="experience[<%= index %>][achievements]" rows="3"><%= exp.achievements ? exp.achievements.join('\n') : '' %></textarea>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-danger remove-experience">Remove</button>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="experience-item mb-3 p-3 border rounded">
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Company</label>
                                                    <input type="text" class="form-control" name="experience[0][company]" required>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Position</label>
                                                    <input type="text" class="form-control" name="experience[0][position]" required>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Location</label>
                                                    <input type="text" class="form-control" name="experience[0][location]">
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Start Date</label>
                                                    <input type="date" class="form-control" name="experience[0][startDate]" required>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">End Date</label>
                                                <input type="date" class="form-control" name="experience[0][endDate]" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Description</label>
                                                <textarea class="form-control" name="experience[0][description]" rows="3"></textarea>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Achievements (one per line)</label>
                                                <textarea class="form-control" name="experience[0][achievements]" rows="3"></textarea>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-danger remove-experience">Remove</button>
                                        </div>
                                    <% } %>
                                </div>
                                <button type="button" class="btn btn-outline-primary" id="addExperience">
                                    <i class="fas fa-plus"></i> Add Experience
                                </button>
                            </div>

                            <div class="mb-4" id="skills">
                                <h4>Skills</h4>
                                <hr>
                                <div class="mb-3">
                                    <label for="skillsInput" class="form-label">Add Skills (press Enter after each skill)</label>
                                    <input type="text" class="form-control" id="skillsInput" placeholder="e.g., JavaScript, Project Management">
                                </div>
                                <div id="skillsContainer" class="mb-3">
                                    <% if (resume.skills && resume.skills.length > 0) { %>
                                        <% resume.skills.forEach(skill => { %>
                                            <span class="badge bg-primary me-2 mb-2 p-2">
                                                <%= skill %>
                                                <input type="hidden" name="skills[]" value="<%= skill %>">
                                                <i class="fas fa-times ms-1 remove-skill" style="cursor: pointer;"></i>
                                            </span>
                                        <% }); %>
                                    <% } %>
                                </div>
                            </div>

                            <div class="mb-4" id="projects">
                                <h4>Projects</h4>
                                <hr>
                                <div id="projectsContainer">
                                    <% if (resume.projects && resume.projects.length > 0) { %>
                                        <% resume.projects.forEach((project, index) => { %>
                                            <div class="project-item mb-3 p-3 border rounded">
                                                <div class="mb-3">
                                                    <label class="form-label">Project Name</label>
                                                    <input type="text" class="form-control" name="projects[<%= index %>][name]" 
                                                           value="<%= project.name %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Description</label>
                                                    <textarea class="form-control" name="projects[<%= index %>][description]" rows="3"><%= project.description || '' %></textarea>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Technologies (comma separated)</label>
                                                    <input type="text" class="form-control" name="projects[<%= index %>][technologies]" 
                                                           value="<%= project.technologies ? project.technologies.join(', ') : '' %>">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Project Link</label>
                                                    <input type="url" class="form-control" name="projects[<%= index %>][link]" 
                                                           value="<%= project.link || '' %>">
                                                </div>
                                                <button type="button" class="btn btn-sm btn-danger remove-project">Remove</button>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        <div class="project-item mb-3 p-3 border rounded">
                                            <div class="mb-3">
                                                <label class="form-label">Project Name</label>
                                                <input type="text" class="form-control" name="projects[0][name]" required>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Description</label>
                                                <textarea class="form-control" name="projects[0][description]" rows="3"></textarea>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Technologies (comma separated)</label>
                                                <input type="text" class="form-control" name="projects[0][technologies]">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Project Link</label>
                                                <input type="url" class="form-control" name="projects[0][link]">
                                            </div>
                                            <button type="button" class="btn btn-sm btn-danger remove-project">Remove</button>
                                        </div>
                                    <% } %>
                                </div>
                                <button type="button" class="btn btn-outline-primary" id="addProject">
                                    <i class="fas fa-plus"></i> Add Project
                                </button>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save"></i> Save Resume
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        $(document).ready(function() {
            // Handle form submission
            $('#resumeForm').on('submit', function(e) {
                e.preventDefault();
                
                const resumeId = $(this).data('resume-id');
                const formData = new FormData(this);
                
                // Convert FormData to JSON
                const jsonData = {};
                for (const [key, value] of formData.entries()) {
                    if (key.includes('[') && key.includes(']')) {
                        // Handle array inputs
                        const matches = key.match(/(\w+)\[(\d+)\]\[(\w+)\]/);
                        if (matches) {
                            const [, section, index, field] = matches;
                            if (!jsonData[section]) jsonData[section] = [];
                            if (!jsonData[section][index]) jsonData[section][index] = {};
                            jsonData[section][index][field] = value;
                        }
                    } else if (key.includes('[]')) {
                        // Handle array inputs like skills[]
                        const baseKey = key.replace('[]', '');
                        if (!jsonData[baseKey]) jsonData[baseKey] = [];
                        jsonData[baseKey].push(value);
                    } else {
                        jsonData[key] = value;
                    }
                }
                
                // Send AJAX request
                $.ajax({
                    url: `/resume/update/${resumeId}`,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(jsonData),
                    success: function(response) {
                        if (response.success) {
                            alert('Resume saved successfully!');
                            window.location.href = '/dashboard';
                        } else {
                            alert('Error saving resume: ' + response.error);
                        }
                    },
                    error: function(xhr) {
                        alert('Error saving resume. Please try again.');
                    }
                });
            });
            
            // Add education
            $('#addEducation').click(function() {
                const index = $('.education-item').length;
                const newEducation = `
                    <div class="education-item mb-3 p-3 border rounded">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">School</label>
                                <input type="text" class="form-control" name="education[${index}][school]" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Degree</label>
                                <input type="text" class="form-control" name="education[${index}][degree]" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Field of Study</label>
                                <input type="text" class="form-control" name="education[${index}][field]">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">GPA</label>
                                <input type="text" class="form-control" name="education[${index}][gpa]">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" class="form-control" name="education[${index}][startDate]" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">End Date</label>
                                <input type="date" class="form-control" name="education[${index}][endDate]" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="education[${index}][description]" rows="2"></textarea>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger remove-education">Remove</button>
                    </div>
                `;
                $('#educationContainer').append(newEducation);
            });
            
            // Remove education
            $(document).on('click', '.remove-education', function() {
                $(this).closest('.education-item').remove();
            });
            
            // Add experience
            $('#addExperience').click(function() {
                const index = $('.experience-item').length;
                const newExperience = `
                    <div class="experience-item mb-3 p-3 border rounded">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Company</label>
                                <input type="text" class="form-control" name="experience[${index}][company]" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Position</label>
                                <input type="text" class="form-control" name="experience[${index}][position]" required>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Location</label>
                                <input type="text" class="form-control" name="experience[${index}][location]">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" class="form-control" name="experience[${index}][startDate]" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" name="experience[${index}][endDate]" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="experience[${index}][description]" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Achievements (one per line)</label>
                            <textarea class="form-control" name="experience[${index}][achievements]" rows="3"></textarea>
                        </div>
                        <button type="button" class="btn btn-sm btn-danger remove-experience">Remove</button>
                    </div>
                `;
                $('#experienceContainer').append(newExperience);
            });
            
            // Remove experience
            $(document).on('click', '.remove-experience', function() {
                $(this).closest('.experience-item').remove();
            });
            
            // Add project
            $('#addProject').click(function() {
                const index = $('.project-item').length;
                const newProject = `
                    <div class="project-item mb-3 p-3 border rounded">
                        <div class="mb-3">
                            <label class="form-label">Project Name</label>
                            <input type="text" class="form-control" name="projects[${index}][name]" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" name="projects[${index}][description]" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Technologies (comma separated)</label>
                            <input type="text" class="form-control" name="projects[${index}][technologies]">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Project Link</label>
                            <input type="url" class="form-control" name="projects[${index}][link]">
                        </div>
                        <button type="button" class="btn btn-sm btn-danger remove-project">Remove</button>
                    </div>
                `;
                $('#projectsContainer').append(newProject);
            });
            
            // Remove project
            $(document).on('click', '.remove-project', function() {
                $(this).closest('.project-item').remove();
            });
            
            // Skills input
            $('#skillsInput').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    const skill = $(this).val().trim();
                    if (skill) {
                        const skillElement = `
                            <span class="badge bg-primary me-2 mb-2 p-2">
                                ${skill}
                                <input type="hidden" name="skills[]" value="${skill}">
                                <i class="fas fa-times ms-1 remove-skill" style="cursor: pointer;"></i>
                            </span>
                        `;
                        $('#skillsContainer').append(skillElement);
                        $(this).val('');
                    }
                }
            });
            
            // Remove skill
            $(document).on('click', '.remove-skill', function() {
                $(this).parent().remove();
            });
        });
    </script>
</body>
</html> 