<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preview Resume - Resume Builder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        .preview-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            background: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .action-buttons {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }
        /* Add styles for the resume preview */
        .resume-preview {
            background: white;
            padding: 40px;
            margin: 20px auto;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        /* Print styles */
        @media print {
            .no-print {
                display: none !important;
            }
            .resume-preview {
                box-shadow: none;
                padding: 0;
                margin: 0;
            }
            .preview-container {
                box-shadow: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container py-5">
        <div class="row mb-4 no-print">
            <div class="col">
                <h1 class="display-4">Preview Resume</h1>
                <p class="lead">Review your resume before downloading</p>
            </div>
            <div class="col-auto">
                <a href="/dashboard" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>

        <div class="preview-container">
            <div class="resume-preview">
                <%- template %>
            </div>
        </div>

        <div class="action-buttons no-print">
            <a href="/resume/download/<%= resume._id %>" class="btn btn-primary btn-lg">
                <i class="fas fa-download"></i> Download PDF
            </a>
            <button onclick="window.print()" class="btn btn-secondary btn-lg ms-2">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 