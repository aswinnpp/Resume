<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Template - Resume Builder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .template-card {
            transition: transform 0.2s;
            cursor: pointer;
        }
        .template-card:hover {
            transform: translateY(-5px);
        }
        .template-preview {
            height: 400px;
            overflow: hidden;
            border: 1px solid #dee2e6;
            border-radius: 0.25rem;
        }
        .template-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="container py-5">
        <div class="row mb-4">
            <div class="col">
                <h1 class="display-4">Select a Template</h1>
                <p class="lead">Choose a template for your resume</p>
            </div>
            <div class="col-auto">
                <a href="/dashboard" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>

        <% if (messages.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= messages.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row">
            <% templates.forEach(template => { %>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card template-card h-100">
                        <div class="template-preview">
                            <img src="<%= template.thumbnail %>" alt="<%= template.name %>" class="img-fluid">
                        </div>
                        <div class="card-body">
                            <h5 class="card-title"><%= template.name %></h5>
                            <p class="card-text"><%= template.description %></p>
                            <a href="/resume/edit?template=<%= template._id %>" class="btn btn-primary w-100">
                                Use This Template
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 