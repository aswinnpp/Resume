<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume Templates - Resume Builder</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/header') %>

    <div class="container py-5">
        <div class="row mb-4">
            <div class="col">
                <h1 class="display-4">Resume Templates</h1>
                <p class="lead">Choose a template for your resume</p>
            </div>
        </div>

        <% if (messages && messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= messages.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (messages && messages.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= messages.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row">
            <!-- Template 1 -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 template-card" data-template="template1">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">Professional</h5>
                    </div>
                    <div class="card-body">
                        <div class="template-preview mb-3">
                            <img src="/images/templates/template1.png" alt="Professional Template" class="img-fluid">
                        </div>
                        <p class="card-text">A clean, professional template with a modern design. Perfect for most industries.</p>
                    </div>
                    <div class="card-footer">
                        <a href="/resume/new?template=template1" class="btn btn-primary w-100">Use This Template</a>
                    </div>
                </div>
            </div>

            <!-- Template 2 -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 template-card" data-template="template2">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">Minimal</h5>
                    </div>
                    <div class="card-body">
                        <div class="template-preview mb-3">
                            <img src="/images/templates/template2.png" alt="Minimal Template" class="img-fluid">
                        </div>
                        <p class="card-text">A minimalist design with a focus on content. Great for creative professionals.</p>
                    </div>
                    <div class="card-footer">
                        <a href="/resume/new?template=template2" class="btn btn-success w-100">Use This Template</a>
                    </div>
                </div>
            </div>

            <!-- Template 3 (Coming Soon) -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 template-card disabled">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="card-title mb-0">Creative <span class="badge bg-warning">Coming Soon</span></h5>
                    </div>
                    <div class="card-body">
                        <div class="template-preview mb-3">
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-paint-brush fa-3x text-muted"></i>
                            </div>
                        </div>
                        <p class="card-text">A creative template with unique design elements. Perfect for artists and designers.</p>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-secondary w-100" disabled>Coming Soon</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html> 