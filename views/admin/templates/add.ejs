<%- include('../../partials/admin-header') %>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Add New Template</h3>
                </div>
                <div class="card-body">
                    <form action="/admin/templates" method="POST" enctype="multipart/form-data">
                        <!-- Basic Information -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="name" class="form-label">Template Name *</label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="name" 
                                           name="name" 
                                           required 
                                           placeholder="Enter template name">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="category" class="form-label">Category *</label>
                                    <select class="form-select" id="category" name="category" required>
                                        <option value="">Select category</option>
                                        <option value="professional">Professional</option>
                                        <option value="creative">Creative</option>
                                        <option value="academic">Academic</option>
                                        <option value="technical">Technical</option>
                                        <option value="minimal">Minimal</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="form-group mb-4">
                            <label for="description" class="form-label">Description *</label>
                            <textarea class="form-control" 
                                    id="description" 
                                    name="description" 
                                    rows="3" 
                                    required 
                                    placeholder="Enter template description"></textarea>
                        </div>

                        <!-- Images -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="thumbnail" class="form-label">Thumbnail Image</label>
                                    <input type="file" 
                                           class="form-control" 
                                           id="thumbnail" 
                                           name="thumbnail" 
                                           accept="image/*">
                                    <small class="text-muted">Recommended size: 300x200px</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="preview" class="form-label">Preview Image</label>
                                    <input type="file" 
                                           class="form-control" 
                                           id="preview" 
                                           name="preview" 
                                           accept="image/*">
                                    <small class="text-muted">Recommended size: 800x1000px</small>
                                </div>
                            </div>
                        </div>

                        <!-- Template Code -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="html" class="form-label">HTML Template *</label>
                                    <textarea class="form-control code-editor" 
                                            id="html" 
                                            name="html" 
                                            rows="10" 
                                            required 
                                            placeholder="Enter HTML template code"></textarea>
                                    <small class="text-muted">Use {{variable}} for dynamic content</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="css" class="form-label">CSS Styles *</label>
                                    <textarea class="form-control code-editor" 
                                            id="css" 
                                            name="css" 
                                            rows="10" 
                                            required 
                                            placeholder="Enter CSS styles"></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="form-check mb-4">
                            <input type="checkbox" 
                                   class="form-check-input" 
                                   id="isActive" 
                                   name="isActive" 
                                   checked>
                            <label class="form-check-label" for="isActive">
                                Template is active and available for use
                            </label>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/admin/templates" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Template</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Code Editor Enhancement -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/monokai.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/css/css.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize HTML editor
    const htmlEditor = CodeMirror.fromTextArea(document.getElementById('html'), {
        mode: 'xml',
        theme: 'monokai',
        lineNumbers: true,
        autoCloseTags: true,
        autoCloseBrackets: true,
        indentUnit: 4
    });

    // Initialize CSS editor
    const cssEditor = CodeMirror.fromTextArea(document.getElementById('css'), {
        mode: 'css',
        theme: 'monokai',
        lineNumbers: true,
        autoCloseBrackets: true,
        indentUnit: 4
    });
});
</script>

<%- include('../../partials/admin-footer') %> 