<%- include('../partials/admin-header') %>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h1 class="h3 mb-4">User Management</h1>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Search Users</h6>
        </div>
        <div class="card-body">
            <form id="searchForm" class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" id="searchName" placeholder="Search by name">
                </div>
                <div class="col-md-4">
                    <input type="email" class="form-control" id="searchEmail" placeholder="Search by email">
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="statusFilter">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Users</h6>
            <div class="dropdown no-arrow">
                <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown">
                    <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in">
                    <div class="dropdown-header">Export Options:</div>
                    <a class="dropdown-item" href="#" id="exportCSV">Export as CSV</a>
                    <a class="dropdown-item" href="#" id="exportPDF">Export as PDF</a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="usersTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Joined Date</th>
                            <th>Status</th>
                            <th>Resumes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.name %></td>
                            <td><%= user.email %></td>
                            <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                            <td>
                                <span class="badge <%= user.isActive ? 'bg-success' : 'bg-danger' %>">
                                    <%= user.isActive ? 'Active' : 'Inactive' %>
                                </span>
                            </td>
                            <td><%= user.resumeCount %></td>
                            <td>
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-sm btn-info" onclick="viewUser('<%= user._id %>')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-warning" onclick="editUser('<%= user._id %>')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteUser('<%= user._id %>')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- User Modal -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">User Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="userForm">
                    <input type="hidden" id="userId">
                    <div class="mb-3">
                        <label for="userName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="userName" required>
                    </div>
                    <div class="mb-3">
                        <label for="userEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="userEmail" required>
                    </div>
                    <div class="mb-3">
                        <label for="userStatus" class="form-label">Status</label>
                        <select class="form-select" id="userStatus">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Resumes</label>
                        <div id="userResumes" class="list-group">
                            <!-- Resumes will be loaded here -->
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveUser()">Save changes</button>
            </div>
        </div>
    </div>
</div>

<script>
// Initialize DataTable
$(document).ready(function() {
    $('#usersTable').DataTable({
        order: [[2, 'desc']], // Sort by joined date by default
        pageLength: 10
    });
});

// Search form handler
$('#searchForm').on('submit', function(e) {
    e.preventDefault();
    const name = $('#searchName').val();
    const email = $('#searchEmail').val();
    const status = $('#statusFilter').val();
    
    // Implement search functionality
    // This should make an AJAX call to your backend
});

// Export handlers
$('#exportCSV').click(function() {
    // Implement CSV export
});

$('#exportPDF').click(function() {
    // Implement PDF export
});

// User management functions
function viewUser(userId) {
    // Load user data and show modal
    $.get(`/admin/users/${userId}`, function(user) {
        $('#userId').val(user._id);
        $('#userName').val(user.name);
        $('#userEmail').val(user.email);
        $('#userStatus').val(user.isActive);
        
        // Load user's resumes
        const resumesHtml = user.resumes.map(resume => `
            <a href="#" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1">${resume.title}</h6>
                    <small>${new Date(resume.createdAt).toLocaleDateString()}</small>
                </div>
                <p class="mb-1">${resume.summary}</p>
            </a>
        `).join('');
        
        $('#userResumes').html(resumesHtml);
        $('#userModal').modal('show');
    });
}

function editUser(userId) {
    viewUser(userId);
}

function saveUser() {
    const userId = $('#userId').val();
    const userData = {
        name: $('#userName').val(),
        email: $('#userEmail').val(),
        isActive: $('#userStatus').val() === 'true'
    };
    
    $.ajax({
        url: `/admin/users/${userId}`,
        method: 'PUT',
        data: userData,
        success: function(response) {
            $('#userModal').modal('hide');
            // Refresh the table or show success message
            location.reload();
        },
        error: function(error) {
            // Show error message
            alert('Error updating user');
        }
    });
}

function deleteUser(userId) {
    if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
        $.ajax({
            url: `/admin/users/${userId}`,
            method: 'DELETE',
            success: function(response) {
                // Remove the row from the table or refresh
                location.reload();
            },
            error: function(error) {
                alert('Error deleting user');
            }
        });
    }
}
</script>

<%- include('../partials/admin-footer') %> 