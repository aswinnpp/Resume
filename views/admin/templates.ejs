<%- include('../partials/admin-header') %>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h1 class="h3 mb-4">Template Management</h1>
        </div>
    </div>

    <!-- Template Stats -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Templates</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.totalTemplates %></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Templates</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.activeTemplates %></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Usage</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.totalUsage %></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Most Used Template</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.mostUsedTemplate %></div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-star fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Templates Grid -->
    <div class="row">
        <% templates.forEach(template => { %>
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card shadow h-100">
                <img src="/images/templates/<%= template.preview %>" class="card-img-top" alt="<%= template.name %>">
                <div class="card-body">
                    <h5 class="card-title"><%= template.name %></h5>
                    <p class="card-text"><%= template.description %></p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge <%= template.isActive ? 'bg-success' : 'bg-danger' %>">
                            <%= template.isActive ? 'Active' : 'Inactive' %>
                        </span>
                        <small class="text-muted">Used <%= template.usageCount %> times</small>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-info" onclick="previewTemplate('<%= template._id %>')">
                            <i class="fas fa-eye"></i> Preview
                        </button>
                        <button type="button" class="btn btn-warning" onclick="editTemplate('<%= template._id %>')">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-danger" onclick="deleteTemplate('<%= template._id %>')">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    </div>

    <!-- Add Template Button -->
    <div class="row">
        <div class="col-12">
            <button type="button" class="btn btn-primary" onclick="showAddTemplateModal()">
                <i class="fas fa-plus"></i> Add New Template
            </button>
        </div>
    </div>
</div>

<!-- Template Modal -->
<div class="modal fade" id="templateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Template Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="templateForm">
                    <input type="hidden" id="templateId">
                    <div class="mb-3">
                        <label for="templateName" class="form-label">Template Name</label>
                        <input type="text" class="form-control" id="templateName" required>
                    </div>
                    <div class="mb-3">
                        <label for="templateDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="templateDescription" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="templateStatus" class="form-label">Status</label>
                        <select class="form-select" id="templateStatus">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="templatePreview" class="form-label">Preview Image</label>
                        <input type="file" class="form-control" id="templatePreview" accept="image/*">
                    </div>
                    <div class="mb-3">
                        <label for="templateFile" class="form-label">Template File</label>
                        <input type="file" class="form-control" id="templateFile" accept=".ejs">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveTemplate()">Save changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Template Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <iframe id="previewFrame" style="width: 100%; height: 80vh; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<script>
// Template management functions
function showAddTemplateModal() {
    $('#templateId').val('');
    $('#templateForm')[0].reset();
    $('#templateModal').modal('show');
}

function previewTemplate(templateId) {
    $('#previewFrame').attr('src', `/admin/templates/${templateId}/preview`);
    $('#previewModal').modal('show');
}

function editTemplate(templateId) {
    $.get(`/admin/templates/${templateId}`, function(template) {
        $('#templateId').val(template._id);
        $('#templateName').val(template.name);
        $('#templateDescription').val(template.description);
        $('#templateStatus').val(template.isActive);
        $('#templateModal').modal('show');
    });
}

function saveTemplate() {
    const templateId = $('#templateId').val();
    const formData = new FormData();
    formData.append('name', $('#templateName').val());
    formData.append('description', $('#templateDescription').val());
    formData.append('isActive', $('#templateStatus').val());
    
    const previewFile = $('#templatePreview')[0].files[0];
    if (previewFile) {
        formData.append('preview', previewFile);
    }
    
    const templateFile = $('#templateFile')[0].files[0];
    if (templateFile) {
        formData.append('template', templateFile);
    }
    
    const url = templateId ? `/admin/templates/${templateId}` : '/admin/templates';
    const method = templateId ? 'PUT' : 'POST';
    
    $.ajax({
        url: url,
        method: method,
        data: formData,
        processData: false,
        contentType: false,
        success: function(response) {
            $('#templateModal').modal('hide');
            location.reload();
        },
        error: function(error) {
            alert('Error saving template');
        }
    });
}

function deleteTemplate(templateId) {
    if (confirm('Are you sure you want to delete this template? This action cannot be undone.')) {
        $.ajax({
            url: `/admin/templates/${templateId}`,
            method: 'DELETE',
            success: function(response) {
                location.reload();
            },
            error: function(error) {
                alert('Error deleting template');
            }
        });
    }
}
</script>

<%- include('../partials/admin-footer') %> 