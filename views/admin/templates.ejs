<%- include('../partials/admin-header') %>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2">Template Management</h1>
            <p class="text-muted">Manage resume templates</p>
        </div>
        <div class="col-auto">
            <a href="/admin/templates/add" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Template
            </a>
        </div>
    </div>

    <% if (messages.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= messages.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (messages.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= messages.error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row">
        <% templates.forEach(function(template) { %>
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <% if (template.thumbnail) { %>
                        <img src="<%= template.thumbnail %>" class="card-img-top template-preview" alt="<%= template.name %> preview">
                    <% } %>
                    <div class="card-body">
                        <h5 class="card-title d-flex justify-content-between align-items-center">
                            <%= template.name %>
                            <span class="badge bg-<%= template.isActive ? 'success' : 'danger' %>">
                                <%= template.isActive ? 'Active' : 'Inactive' %>
                            </span>
                        </h5>
                        <p class="card-text"><%= template.description %></p>
                        <div class="mb-3">
                            <span class="badge bg-info">
                                <i class="fas fa-tag"></i> <%= template.category %>
                            </span>
                            <span class="badge bg-secondary">
                                <i class="fas fa-chart-bar"></i> Used <%= template.usageCount %> times
                            </span>
                        </div>
                        <div class="d-grid gap-2">
                            <div class="btn-group">
                                <a href="/admin/templates/edit/<%= template._id %>" class="btn btn-outline-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="/admin/templates/<%= template._id %>/preview" class="btn btn-outline-secondary">
                                    <i class="fas fa-eye"></i> Preview
                                </a>
                            </div>
                            <form action="/admin/templates/<%= template._id %>/use" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-plus"></i> Use Template
                                </button>
                            </form>
                            <button class="btn btn-outline-danger delete-template" data-template-id="<%= template._id %>">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<%- include('../partials/admin-footer') %>

<style>
.template-preview {
    height: 200px;
    object-fit: cover;
    border-bottom: 1px solid #dee2e6;
}
.card {
    transition: transform 0.2s;
}
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}
.badge {
    font-size: 0.8rem;
}
</style>

<script>
document.querySelectorAll('.delete-template').forEach(button => {
    button.addEventListener('click', async (e) => {
        if (confirm('Are you sure you want to delete this template? This action cannot be undone.')) {
            const templateId = e.target.dataset.templateId;
            try {
                const response = await fetch(`/admin/templates/${templateId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.error || 'Error deleting template');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error deleting template');
            }
        }
    });
});
</script> 