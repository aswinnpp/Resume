<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume Builder - Create Professional Resumes</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/header') %>

    <!-- Hero Section -->
    <div class="bg-primary text-white py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="display-4 fw-bold">Create Your Professional Resume</h1>
                    <p class="lead">Build a stunning resume in minutes with our easy-to-use builder. Choose from professionally designed templates and get hired faster.</p>
                    <% if (!user) { %>
                        <a href="/register" class="btn btn-light btn-lg me-3">Get Started</a>
                        <a href="/login" class="btn btn-outline-light btn-lg">Login</a>
                    <% } else { %>
                        <a href="/templates" class="btn btn-light btn-lg">Create Resume</a>
                    <% } %>
                </div>
                <div class="col-md-6">
                    <img src="/images/hero-image.png" alt="Resume Builder" class="img-fluid">
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="container py-5">
        <h2 class="text-center mb-5">Why Choose Our Resume Builder?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-paint-brush fa-3x text-primary mb-3"></i>
                        <h3 class="card-title h4">Professional Templates</h3>
                        <p class="card-text">Choose from a variety of professionally designed templates that stand out.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-magic fa-3x text-primary mb-3"></i>
                        <h3 class="card-title h4">Easy to Use</h3>
                        <p class="card-text">Our intuitive builder makes it simple to create a professional resume in minutes.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-download fa-3x text-primary mb-3"></i>
                        <h3 class="card-title h4">PDF Download</h3>
                        <p class="card-text">Download your resume in PDF format, ready to send to employers.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="bg-light py-5">
        <div class="container">
            <h2 class="text-center mb-5">How It Works</h2>
            <div class="row">
                <div class="col-md-3">
                    <div class="text-center">
                        <div class="circle bg-primary text-white mb-3">1</div>
                        <h4>Choose Template</h4>
                        <p>Select from our professionally designed templates.</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-center">
                        <div class="circle bg-primary text-white mb-3">2</div>
                        <h4>Fill Details</h4>
                        <p>Enter your information in our easy-to-use form.</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-center">
                        <div class="circle bg-primary text-white mb-3">3</div>
                        <h4>Preview</h4>
                        <p>Review your resume and make any necessary changes.</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-center">
                        <div class="circle bg-primary text-white mb-3">4</div>
                        <h4>Download</h4>
                        <p>Download your resume in PDF format.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="/js/main.js"></script>
</body>
</html> 