<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume Builder - Create Professional Resumes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6">
                <h1 class="display-4 mb-4">Create Your Professional Resume</h1>
                <p class="lead mb-4">Build a stunning resume in minutes with our easy-to-use resume builder. Choose from professional templates and customize to your needs.</p>
                <div class="d-grid gap-3 d-md-flex">
                    <a href="/register" class="btn btn-primary btn-lg me-md-2">Get Started</a>
                    <a href="/login" class="btn btn-outline-secondary btn-lg">Sign In</a>
                </div>
            </div>
            <div class="col-md-6">
                <img src="/images/resume-preview.svg" alt="Resume Preview" class="img-fluid rounded shadow">
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12 text-center mb-4">
                <h2>Why Choose Our Resume Builder?</h2>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-paint-brush fa-3x mb-3 text-primary"></i>
                        <h3 class="card-title">Professional Templates</h3>
                        <p class="card-text">Choose from a variety of professionally designed templates that stand out to employers.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-magic fa-3x mb-3 text-primary"></i>
                        <h3 class="card-title">Easy Customization</h3>
                        <p class="card-text">Customize every aspect of your resume with our intuitive builder interface.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-file-pdf fa-3x mb-3 text-primary"></i>
                        <h3 class="card-title">Instant Download</h3>
                        <p class="card-text">Download your resume as a PDF file instantly, ready to send to employers.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12 text-center mb-4">
                <h2>Featured Templates</h2>
            </div>
            <div class="col-md-4">
                <div class="card template-card">
                    <img src="/images/templates/template1.svg" class="card-img-top" alt="Template 1">
                    <div class="card-body">
                        <h5 class="card-title">Professional</h5>
                        <p class="card-text">Clean and professional design perfect for any industry.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card template-card">
                    <img src="/images/templates/template2.svg" class="card-img-top" alt="Template 2">
                    <div class="card-body">
                        <h5 class="card-title">Modern</h5>
                        <p class="card-text">Contemporary design with a focus on readability and style.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card template-card">
                    <img src="/images/templates/template3.svg" class="card-img-top" alt="Template 3">
                    <div class="card-body">
                        <h5 class="card-title">Executive</h5>
                        <p class="card-text">Elegant design for senior professionals and executives.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="/js/main.js"></script>
</body>
</html> 