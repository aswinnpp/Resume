<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume - <%= data.personalInfo.fullName %></title>
    <style>
        body {
            font-family: 'Georgia', serif;
            line-height: 1.6;
            margin: 0;
            padding: 40px;
            color: #2c3e50;
            background-color: #fff;
        }
        .header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid #34495e;
        }
        .name {
            font-size: 36px;
            font-weight: bold;
            margin: 0;
            color: #2c3e50;
            letter-spacing: 1px;
        }
        .contact-info {
            margin-top: 15px;
            color: #7f8c8d;
            font-size: 1em;
        }
        .contact-info span {
            margin: 0 15px;
        }
        .section {
            margin-bottom: 35px;
        }
        .section-title {
            font-size: 24px;
            font-weight: bold;
            color: #34495e;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-bottom: 2px solid #bdc3c7;
            padding-bottom: 5px;
        }
        .item {
            margin-bottom: 25px;
            padding-left: 20px;
            border-left: 3px solid #34495e;
        }
        .item-title {
            font-weight: bold;
            color: #2c3e50;
            font-size: 1.1em;
            margin-bottom: 5px;
        }
        .item-subtitle {
            color: #34495e;
            font-style: italic;
            margin-bottom: 5px;
        }
        .item-date {
            color: #7f8c8d;
            font-size: 0.9em;
            margin-bottom: 10px;
        }
        .skills-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }
        .skill-item {
            background-color: #f5f6fa;
            padding: 5px 15px;
            border-radius: 3px;
            font-size: 0.9em;
            color: #2c3e50;
            border: 1px solid #bdc3c7;
        }
        .summary {
            font-size: 1.1em;
            line-height: 1.8;
            color: #34495e;
            text-align: justify;
        }
        .project-tech {
            margin-top: 10px;
        }
        .project-link {
            display: inline-block;
            margin-top: 10px;
            color: #34495e;
            text-decoration: none;
            font-weight: bold;
            border-bottom: 1px solid #34495e;
        }
        .project-link:hover {
            color: #2c3e50;
        }
        .gpa {
            font-weight: bold;
            color: #34495e;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="name"><%= data.personalInfo.fullName %></div>
        <div class="contact-info">
            <span><%= data.personalInfo.email %></span>
            <span>|</span>
            <span><%= data.personalInfo.phone %></span>
            <span>|</span>
            <span><%= data.personalInfo.address %></span>
        </div>
    </div>

    <div class="section">
        <div class="section-title">Executive Summary</div>
        <p class="summary"><%= data.personalInfo.summary %></p>
    </div>

    <div class="section">
        <div class="section-title">Professional Experience</div>
        <% data.experience.forEach(function(exp) { %>
            <div class="item">
                <div class="item-title"><%= exp.position %></div>
                <div class="item-subtitle"><%= exp.company %></div>
                <div class="item-date"><%= exp.startDate.toLocaleDateString() %> - <%= exp.endDate.toLocaleDateString() %></div>
                <p><%= exp.description %></p>
            </div>
        <% }); %>
    </div>

    <div class="section">
        <div class="section-title">Education</div>
        <% data.education.forEach(function(edu) { %>
            <div class="item">
                <div class="item-title"><%= edu.school %></div>
                <div class="item-subtitle"><%= edu.degree %> in <%= edu.fieldOfStudy %></div>
                <div class="item-date"><%= edu.startDate.toLocaleDateString() %> - <%= edu.endDate.toLocaleDateString() %></div>
                <% if (edu.gpa) { %>
                    <div class="gpa">GPA: <%= edu.gpa %></div>
                <% } %>
            </div>
        <% }); %>
    </div>

    <div class="section">
        <div class="section-title">Core Competencies</div>
        <div class="skills-list">
            <% data.skills.forEach(function(skill) { %>
                <div class="skill-item"><%= skill %></div>
            <% }); %>
        </div>
    </div>

    <div class="section">
        <div class="section-title">Key Projects</div>
        <% data.projects.forEach(function(project) { %>
            <div class="item">
                <div class="item-title"><%= project.name %></div>
                <p><%= project.description %></p>
                <div class="project-tech">
                    <% project.technologies.forEach(function(tech) { %>
                        <div class="skill-item"><%= tech %></div>
                    <% }); %>
                </div>
                <% if (project.link) { %>
                    <a href="<%= project.link %>" class="project-link" target="_blank">View Project Details</a>
                <% } %>
            </div>
        <% }); %>
    </div>
</body>
</html> 